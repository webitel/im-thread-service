
# Enable mTLS; reqiured CAs, server and client certificates
SERVICE_CONN_VERIFY_CERTS=false

# Log level: debug, info, warn, error (default: info)
LOG_LEVEL=info
LOG_JSON=false
LOG_FILE=

# Enable OpenTelemetry logging
LOG_OTEL=false

# Log to console (default: false)
LOG_CONSOLE=false

POSTGRES_DSN=postgres://postgres:postgres@localhost:5432/webitel?&sslmode=disable&connect_timeout=10

REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

CONSUL_ADDR=localhost:8500

# Leader election (Consul session-lock used to elect the single active outbox-forwarder node).

# Consul session TTL for the leader lock. Consul enforces a 10s floor.
LEADER_ELECTION_TTL=10s

# How often the leader renews its Consul session heartbeat. Must be at most half of TTL,
# so at least one missed renewal can be tolerated within the TTL window.
LEADER_ELECTION_RENEW_INTERVAL=5s

# Backoff after a transient Consul error (session create/acquire failure) before retrying.
LEADER_ELECTION_ERR_COOLDOWN=5s

# Max duration a Consul blocking query is held open before being reissued; acts as a
# safety-net upper bound on failover latency if a change notification is ever missed.
LEADER_ELECTION_BLOCKING_WAIT=10s

# Consul's post-release anti-flapping grace period. Must be > 0 (Consul ignores an
# explicit 0 and falls back to its own 15s default). Kept low since the outbox
# forwarder is idempotent (offset-tracked in Postgres).
LEADER_ELECTION_LOCK_DELAY=1s

PUBSUB_URL=amqp://admin:admin@localhost:5672?heartbeat=10
PUBSUB_DRIVER=amqp
