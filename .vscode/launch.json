{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "IM: Server",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/main.go",
      "args": ["server"],
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "IM: Migrate",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/main.go",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "GOLANG_PROTOBUF_REGISTRATION_CONFLICT": "ignore"
      },
      "args": [
        "server",
      ],
      "console": "integratedTerminal",
      "showLog": true
    }
  ]
}