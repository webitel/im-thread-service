{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "im-thread-service",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/main.go",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "env": {
        "GOLANG_PROTOBUF_REGISTRATION_CONFLICT": "ignore"
      },
      "args": [
        "server",
      ],
      "console": "integratedTerminal",
      "showLog": true
    }
  ]
}