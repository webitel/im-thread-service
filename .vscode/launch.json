{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "IM: Server",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/main.go",
      "args": [
        "server",
        "--config_file=${workspaceFolder}/config/config.yml"
      ],
    },
    {
      "name": "IM: Migrate",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/main.go",
      "args": [
        "migrate"
      ],
      "envFile": "${workspaceFolder}/.env"
    }
  ]
}