{
  "go.lintTool": "golangci-lint",
  "go.lintFlags": [
    "--path-mode=abs"
  ],
  "go.formatTool": "default",
  "go.alternateTools": {
    "customFormatter": "golangci-lint"
  },
  // "go.formatFlags": [
  //   "fmt",
  //   "--stdin"
  // ],
  "editor.formatOnSave": true,
  "[go]": {
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "always"
    }
  }
}